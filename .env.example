# Set this to the private LAN IPv4 address of the server or NAS.
# POWERWATCH_BIND_IP=192.168.0.50
POWERWATCH_BIND_IP=127.0.0.1

# Optional integrated authentication (disabled by default).
# For the first authenticated start only, replace the setup token with a
# random value of at least 16 characters. Remove it after account creation.
POWERWATCH_AUTH_ENABLED=false
# POWERWATCH_AUTH_SETUP_TOKEN=replace-with-a-long-random-secret
